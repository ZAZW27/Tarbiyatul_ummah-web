generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id             Int             @id @default(autoincrement())
  cat_name       String          @unique @db.VarChar(100)
  cat_type       String          @db.VarChar(50)
  
  item_categories ItemCategory[]

  @@map("categories")
}

model Item {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String?
  price       Decimal?  @db.Decimal(12, 2)
  stock       Int?      @default(0)
  image_url   String
  status      String?   @default("active") @db.VarChar(20)
  create_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  item_categories ItemCategory[]
  transactions    Transaction[]

  @@map("items")
}

model ItemCategory {
  item_id     Int
  category_id Int

  item     Item     @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([item_id, category_id])
  @@map("item_categories")
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  item_id    Int
  action     String    @db.VarChar(20)
  old_data   Json?     @db.JsonB
  changed_at DateTime? @default(now()) @db.Timestamp(6)

  @@map("audit_logs")
}

model CashBalance {
  id           Int       @id @default(autoincrement())
  total_amount Decimal?  @default(0) @db.Decimal(15, 2)
  last_updated DateTime? @default(now()) @db.Timestamp(6)

  @@map("cash_balance")
}

model Transaction {
  id               Int       @id @default(autoincrement())
  item_id          Int?
  item             Item?     @relation(fields: [item_id], references: [id], onUpdate: NoAction, onDelete: SetNull)
  quantity         Int
  total_price      Decimal   @db.Decimal(15, 2)
  transaction_date DateTime? @default(now()) @db.Timestamp(6)

  @@map("transactions")
}

model Role {
  id          Int     @id @default(autoincrement())
  role_name   String  @unique @db.VarChar(50)
  description String?
  
  users User[]

  @@map("roles")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(100)
  password_hash String    @db.VarChar(255)
  role_id       Int?
  role          Role?     @relation(fields: [role_id], references: [id], onUpdate: NoAction, onDelete: Restrict)
  last_login    DateTime? @db.Timestamp(6)
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  @@map("users")
}